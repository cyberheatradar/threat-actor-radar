{
  "$defs": {
    "actionEvidence": {
      "additionalProperties": false,
      "properties": {
        "block_index": {
          "minimum": 0,
          "type": "integer"
        },
        "excerpt": {
          "minLength": 1,
          "type": "string"
        },
        "id": {
          "pattern": "^tar_evidence_[0-9a-f]{24}$",
          "type": "string"
        },
        "order": {
          "minimum": 0,
          "type": "integer"
        },
        "source_id": {
          "pattern": "^tar_source_[0-9a-f]{24}$",
          "type": "string"
        }
      },
      "required": [
        "id",
        "source_id",
        "excerpt",
        "order",
        "block_index"
      ],
      "type": "object"
    },
    "actionObservation": {
      "additionalProperties": false,
      "properties": {
        "action_time_text": {
          "type": [
            "string",
            "null"
          ]
        },
        "action_type": {
          "enum": [
            "action",
            "malware_behavior"
          ]
        },
        "activity_id": {
          "pattern": "^tar_activity_[0-9a-f]{24}$",
          "type": "string"
        },
        "actor_id": {
          "pattern": "^tar_actor_[0-9a-f]{24}$",
          "type": "string"
        },
        "assertion": {
          "enum": [
            "observed",
            "observed_capability",
            "observed_telemetry",
            "observed_with_limited_detail",
            "likely",
            "possible"
          ]
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low",
            "unknown"
          ]
        },
        "date_basis": {
          "enum": [
            "explicit_source_date",
            "explicit_source_month",
            "bounded_source_range",
            "unresolved"
          ]
        },
        "description": {
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/actionEvidence"
          },
          "minItems": 1,
          "type": "array"
        },
        "first_seen": {
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "flow_node_id": {
          "pattern": "^flow-node:[A-Za-z0-9:_-]+$",
          "type": "string"
        },
        "id": {
          "pattern": "^tar_action_[0-9a-f]{24}$",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "type": "string"
        },
        "last_seen": {
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "relationship_ids": {
          "items": {
            "pattern": "^tar_relationship_[0-9a-f]{24}$",
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "scope_slug": {
          "pattern": "^[a-z0-9-]+$",
          "type": "string"
        },
        "sequence_hint": {
          "minimum": 0,
          "type": "integer"
        },
        "source_ids": {
          "items": {
            "pattern": "^tar_source_[0-9a-f]{24}$",
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "activity_id",
        "actor_id",
        "flow_node_id",
        "scope_slug",
        "action_type",
        "label",
        "description",
        "assertion",
        "confidence",
        "action_time_text",
        "first_seen",
        "last_seen",
        "date_basis",
        "sequence_hint",
        "source_ids",
        "relationship_ids",
        "evidence"
      ],
      "type": "object"
    },
    "activitiesDocument": {
      "additionalProperties": false,
      "properties": {
        "actions": {
          "items": {
            "$ref": "#/$defs/actionObservation"
          },
          "type": "array"
        },
        "activities": {
          "items": {
            "$ref": "#/$defs/activity"
          },
          "type": "array"
        },
        "data_version": {
          "type": "string"
        },
        "schema": {
          "const": "threatactorradar.public-activities/v1"
        }
      },
      "required": [
        "schema",
        "data_version",
        "activities",
        "actions"
      ],
      "type": "object"
    },
    "activity": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "pattern": "^tar_actor_[0-9a-f]{24}$",
          "type": "string"
        },
        "date_basis": {
          "enum": [
            "explicit_source_date",
            "explicit_source_month",
            "bounded_source_range",
            "unresolved"
          ]
        },
        "date_precision": {
          "enum": [
            "day",
            "month",
            "year",
            "unknown"
          ]
        },
        "description": {
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/activityEvidence"
          },
          "minItems": 1,
          "type": "array"
        },
        "first_seen": {
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "flow_path": {
          "pattern": "^attack-flows/[a-z0-9-]+/\\?scope=[a-z0-9-]+$",
          "type": "string"
        },
        "id": {
          "pattern": "^tar_activity_[0-9a-f]{24}$",
          "type": "string"
        },
        "last_seen": {
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "minLength": 1,
          "type": "string"
        },
        "relationship_ids": {
          "items": {
            "pattern": "^tar_relationship_[0-9a-f]{24}$",
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "source_ids": {
          "items": {
            "pattern": "^tar_source_[0-9a-f]{24}$",
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "type": {
          "enum": [
            "campaign",
            "incident",
            "operation"
          ]
        }
      },
      "required": [
        "id",
        "type",
        "actor_id",
        "name",
        "description",
        "first_seen",
        "last_seen",
        "date_basis",
        "date_precision",
        "source_ids",
        "relationship_ids",
        "evidence",
        "flow_path"
      ],
      "type": "object"
    },
    "activityEvidence": {
      "additionalProperties": false,
      "properties": {
        "excerpt": {
          "maxLength": 280,
          "minLength": 1,
          "type": "string"
        },
        "role": {
          "enum": [
            "scope",
            "date",
            "attribution",
            "summary"
          ]
        },
        "source_id": {
          "pattern": "^tar_source_[0-9a-f]{24}$",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "excerpt",
        "role"
      ],
      "type": "object"
    },
    "actor": {
      "additionalProperties": false,
      "properties": {
        "actor_types": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "aliases": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "entity_type": {
          "minLength": 1,
          "type": "string"
        },
        "id": {
          "pattern": "^tar_actor_[0-9a-f]{24}$",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "type": "string"
        },
        "tracking_names": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "name": {
                "minLength": 1,
                "type": "string"
              },
              "scope": {
                "minLength": 1,
                "type": "string"
              },
              "source_url": {
                "pattern": "^https://",
                "type": "string"
              },
              "vendor": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "name",
              "vendor",
              "scope",
              "source_url"
            ],
            "type": "object"
          },
          "type": "array",
          "uniqueItems": true
        },
        "watch_priority": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "watch_rationale": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "entity_type",
        "actor_types",
        "aliases"
      ],
      "type": "object"
    },
    "actorsDocument": {
      "additionalProperties": false,
      "properties": {
        "actors": {
          "items": {
            "$ref": "#/$defs/actor"
          },
          "type": "array"
        },
        "data_version": {
          "const": "v0.3.3"
        },
        "schema": {
          "const": "threatactorradar.public-actors/v1"
        }
      },
      "required": [
        "schema",
        "data_version",
        "actors"
      ],
      "type": "object"
    },
    "command": {
      "additionalProperties": false,
      "properties": {
        "defanged_indicators": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "type": {
                "type": "string"
              },
              "value": {
                "type": "string"
              }
            },
            "required": [
              "type",
              "value"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "id": {
          "pattern": "^tar_command_[0-9a-f]{24}$",
          "type": "string"
        },
        "redaction_count": {
          "minimum": 0,
          "type": "integer"
        },
        "representation": {
          "maxLength": 16000,
          "minLength": 1,
          "type": "string"
        },
        "shell": {
          "type": "string"
        },
        "source_redaction_present": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "shell",
        "representation",
        "redaction_count",
        "source_redaction_present",
        "defanged_indicators"
      ],
      "type": "object"
    },
    "evidence": {
      "additionalProperties": false,
      "properties": {
        "excerpt": {
          "maxLength": 280,
          "minLength": 1,
          "type": "string"
        },
        "source_id": {
          "pattern": "^tar_source_[0-9a-f]{24}$",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "excerpt"
      ],
      "type": "object"
    },
    "relationship": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "pattern": "^tar_actor_[0-9a-f]{24}$",
          "type": "string"
        },
        "confidence": {
          "enum": [
            "explicit",
            "strongly_supported",
            "contextual",
            "inferred"
          ]
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "maxItems": 3,
          "minItems": 1,
          "type": "array"
        },
        "id": {
          "pattern": "^tar_relationship_[0-9a-f]{24}$",
          "type": "string"
        },
        "predicate": {
          "minLength": 1,
          "type": "string"
        },
        "resolution_method": {
          "enum": [
            "deterministic",
            "human_corrected"
          ]
        },
        "resolution_status": {
          "const": "resolved"
        },
        "source_ids": {
          "items": {
            "pattern": "^tar_source_[0-9a-f]{24}$",
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "target_id": {
          "pattern": "^tar_(technique|software|command)_[0-9a-f]{24}$",
          "type": "string"
        },
        "target_type": {
          "enum": [
            "technique",
            "software",
            "command"
          ]
        },
        "type": {
          "enum": [
            "actor_technique_relationship",
            "actor_software_relationship",
            "actor_command_relationship"
          ]
        }
      },
      "required": [
        "id",
        "type",
        "actor_id",
        "target_type",
        "target_id",
        "predicate",
        "resolution_status",
        "confidence",
        "resolution_method",
        "source_ids",
        "evidence"
      ],
      "type": "object"
    },
    "relationshipsDocument": {
      "additionalProperties": false,
      "properties": {
        "commands": {
          "items": {
            "$ref": "#/$defs/command"
          },
          "type": "array"
        },
        "data_version": {
          "const": "v0.3.3"
        },
        "relationships": {
          "items": {
            "$ref": "#/$defs/relationship"
          },
          "type": "array"
        },
        "schema": {
          "const": "threatactorradar.public-relationships/v1"
        },
        "software": {
          "items": {
            "$ref": "#/$defs/software"
          },
          "type": "array"
        },
        "techniques": {
          "items": {
            "$ref": "#/$defs/technique"
          },
          "type": "array"
        }
      },
      "required": [
        "schema",
        "data_version",
        "techniques",
        "software",
        "commands",
        "relationships"
      ],
      "type": "object"
    },
    "software": {
      "additionalProperties": false,
      "properties": {
        "aliases": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "id": {
          "pattern": "^tar_software_[0-9a-f]{24}$",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "type": "string"
        },
        "software_type": {
          "enum": [
            "malware",
            "tool"
          ]
        }
      },
      "required": [
        "id",
        "name",
        "software_type",
        "aliases"
      ],
      "type": "object"
    },
    "source": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^tar_source_[0-9a-f]{24}$",
          "type": "string"
        },
        "published_at": {
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "reliability": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "title": {
          "minLength": 1,
          "type": "string"
        },
        "url": {
          "format": "uri",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "url",
        "reliability"
      ],
      "type": "object"
    },
    "sourcesDocument": {
      "additionalProperties": false,
      "properties": {
        "data_version": {
          "const": "v0.3.3"
        },
        "schema": {
          "const": "threatactorradar.public-sources/v1"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/source"
          },
          "type": "array"
        }
      },
      "required": [
        "schema",
        "data_version",
        "sources"
      ],
      "type": "object"
    },
    "technique": {
      "additionalProperties": false,
      "properties": {
        "attack_id": {
          "pattern": "^T[0-9]{4}(\\.[0-9]{3})?$",
          "type": "string"
        },
        "id": {
          "pattern": "^tar_technique_[0-9a-f]{24}$",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "type": "string"
        },
        "tactics": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "attack_id",
        "name",
        "tactics"
      ],
      "type": "object"
    }
  },
  "$id": "https://threatactorradar.invalid/schema/public-bundle-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "activities": {
      "$ref": "#/$defs/activitiesDocument"
    },
    "actors": {
      "$ref": "#/$defs/actorsDocument"
    },
    "relationships": {
      "$ref": "#/$defs/relationshipsDocument"
    },
    "sources": {
      "$ref": "#/$defs/sourcesDocument"
    }
  },
  "required": [
    "actors",
    "relationships",
    "sources"
  ],
  "title": "ThreatActorRadar Public Data Bundle v1",
  "type": "object"
}
